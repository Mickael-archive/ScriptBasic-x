# Build output.
#
# `./setup` compiles the C tools and the interpreter and writes everything into
# bin/; the headerer tool generates the C headers next to the *.h_bas templates
# it reads (filesys.h is a real source file, the others are not).  None of this
# belongs in the repository.
/bin/

# headers generated by bin/tools/headerer
/basext.h
/builder.h
/buildnum.h
/command.h
/confpile.h
/conftree.h
/dynlolib.h
/epreproc.h
/errcodes.h
/execute.h
/expression.h
/getopt.h
/hndlptr.h
/hookers.h
/httpd.h
/ipreproc.h
/lexer.h
/logger.h
/lsp.h
/match.h
/matchc.h
/md5.h
/memory.h
/modumana.h
/myalloc.h
/mygmtime.h
/mynotimp.h
/notimp.h
/options.h
/prepext.h
/reader.h
/report.h
/scriba.h
/stndlone.h
/sym.h
/syntax.h
/testalloc.h
/thread.h
/uniqfnam.h

# headers generated for the extension modules
/extensions/cgi/cgi.h
/extensions/dbg/dbg.h
/extensions/dbg/dbg_comm.h
/extensions/rpool.h

# headers generated for the build variations
/variations/standalone/libscriba.h
/variations/standard/scribacmd.h
/variations/wx/scribawx.h

# the command reference of the User Guide, generated by bin/tools/mkcdoc
/commands.texi

# the export definition file of the library, generated by bin/tools/mkscribadef
/scriba.def

# the installation files ./setup --install writes: install.sh, mkdeb.sh and
# mkrpm.sh (the release scripts), the Etc init script, the Perl configuration
# and the configuration the script compiles.  Two documents of ./mkth.sh
# (auxfiles and eszterengine) include them, so a tree that ran --install builds
# its documentation in full and leaves no untracked file behind.
/install.sh
/mkdeb.sh
/mkrpm.sh
/etc-init.d-sbhttpd
/config.pl
/scriba.conf.unix.lsp
